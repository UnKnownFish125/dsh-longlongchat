{
  "name": "dsh-longlongchat",
  "version": "0.5.0",
  "description": "LongLongChat：DeepSeek Harness 长对话、长期记忆与上下文清洗 Web 插件",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UnKnownFish125/longlongchat.git"
  },
  "homepage": "https://github.com/UnKnownFish125/longlongchat",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./dsh.patch.yml": "./dsh.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "dsh.patch.yml",
    "package.json"
  ],
  "license": "AGPL-3.0-only",
  "peerDependencies": {
    "@deepseek-ai/dsh-settings": ">=0.1.0-rc.6 <0.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dsh": {
    "category": "Memory",
    "categories": ["Memory"],
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./dsh.patch.yml"
    }
  }
}
